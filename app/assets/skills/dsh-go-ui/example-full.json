{
  "version": 1,
  "header": {
    "actions": [
      "schedule",
      "detail",
      "newChat",
      {
        "id": "daily",
        "icon": "bolt",
        "label": "Daily",
        "action": {
          "type": "send",
          "text": "Write today's daily report from the template"
        }
      }
    ]
  },
  "composer": {
    "quickActions": [
      {
        "label": "Summarize",
        "action": {
          "type": "send",
          "text": "Summarize the conversation above in three points"
        }
      },
      {
        "label": "Compact",
        "action": {
          "type": "command",
          "name": "compact"
        }
      }
    ]
  },
  "emptyState": {
    "suggestions": [
      {
        "title": "See today's to-dos",
        "subtitle": "Read TODO.md in the workspace",
        "action": {
          "type": "send",
          "text": "Read TODO.md and tell me what to do first today"
        }
      }
    ]
  },
  "drawer": {
    "groups": [
      "pinned",
      "folders",
      "today",
      "yesterday",
      "thisWeek",
      "earlier"
    ],
    "sort": "activity",
    "filter": "all"
  },
  "density": "compact",
  "hide": [
    "turnFooter",
    "tokenCount",
    "reasoningDetails"
  ],
  "theme": {
    "mode": "system",
    "accentPreset": "daiqing"
  },
  "pet": {
    "id": "deepy-whale",
    "position": "bottom-right",
    "quiet": true
  },
  "shortcuts": [
    {
      "keys": "ctrl+k",
      "action": {
        "type": "open",
        "page": "search"
      }
    }
  ],
  "plugins": {
    "seats": {
      "conversation.input.dock": {
        "dsh-cost-meter": "hidden"
      }
    }
  }
}
